# ===========================================
# Here's Me Server - Integration Test Configuration
# ===========================================

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heresme_test
DB_USER=postgres
DB_PASSWORD=your_password_here

# AWS Configuration (Optional - for AWS SSM tests)
AWS_REGION=ap-northeast-1
AWS_SSM_ENABLED=false
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# Java Configuration
JAVA_CLASSPATH=util

# Test Configuration
NODE_ENV=test
LOG_LEVEL=debug

# S3 Configuration (Optional - for S3 integration tests)
# S3_BUCKET_NAME=heresme-test-bucket
# S3_ENABLED=false

# ===========================================
# Notes:
# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to git (it's in .gitignore)
# 3. For local testing, set AWS_SSM_ENABLED=false
# ===========================================
