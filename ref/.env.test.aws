# AWS検証環境用テスト設定
# このファイルは検証環境（AWS環境）でのテスト実施時に使用します
#
# 使用方法:
#   1. このファイルを .env にコピー（またはリネーム）
#   2. 必要に応じて値を調整
#   3. テストを実行
#
# ⚠️ 注意:
#   - このファイルには機密情報を含めないでください
#   - DATABASE_URLはSSM Parameter Storeから取得するため設定不要
#   - AWS認証情報はAWS CLIまたはIAMロールから取得

# ==========================================
# 環境設定
# ==========================================

# Node.js実行環境
NODE_ENV=test

# 環境タイプ（0: localhost、1: AWS検証環境/本番環境）
environmentType=1

# ==========================================
# AWS設定
# ==========================================

# AWSリージョン
AWS_REGION=ap-northeast-1

# SSM Parameter Store パラメータ名
# db-util.jsで使用されるDB接続情報のパラメータ名
SSM_PARAMETER_NAME=heresme.db_auth_info

# ==========================================
# テスト設定
# ==========================================

# テストタイムアウト（ミリ秒）
JEST_TIMEOUT=30000

# ログレベル（debug, info, warn, error）
LOG_LEVEL=debug

# ==========================================
# データベース設定
# ==========================================

# ⚠️ AWS環境では以下の設定は使用されません
# DB接続情報はSSM Parameter Storeから取得されます
#
# SSM Parameter Storeに以下の形式で設定してください:
#   Name: heresme.db_auth_info
#   Type: SecureString
#   Value: <RDS_ENDPOINT>,<DB_USER>,<DB_PASSWORD>
#   例: mydb.us-east-1.rds.amazonaws.com,dbadmin,secretpass123

# DATABASE_URLは使用されない（SSMから取得）
# DATABASE_URL=postgresql://user:password@host:5432/database

# ==========================================
# Java設定（パスワード暗号化/復号化用）
# ==========================================

# Javaクラスパス（EncDec.classの場所）
JAVA_CLASSPATH=./util

# Javaコマンド（カスタムJDKを使用する場合はパスを指定）
JAVA_CMD=java

# ==========================================
# テストデータ設定
# ==========================================

# テストデータクリーンアップ有効化
TEST_DATA_CLEANUP=true

# テストデータ自動投入有効化
TEST_DATA_AUTO_SETUP=false

# ==========================================
# AWS認証情報（オプション）
# ==========================================

# ⚠️ 以下の設定は通常不要です
# AWS CLIまたはIAMロールから自動的に取得されます
#
# どうしても明示的に設定する場合のみ使用してください:
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token  # 一時認証情報の場合

# ==========================================
# その他の設定
# ==========================================

# タイムゾーン
TZ=Asia/Tokyo

# ==========================================
# 使用例
# ==========================================

# 【例1】検証環境でのテスト実行
#   1. このファイルを .env にコピー
#      cp ref/.env.test.aws .env
#
#   2. AWS認証情報を設定（AWS CLIまたはIAMロール）
#      aws configure
#
#   3. SSM Parameter StoreにDB接続情報を設定
#      aws ssm put-parameter \
#        --name "heresme.db_auth_info" \
#        --value "your-rds.us-east-1.rds.amazonaws.com,dbuser,dbpass" \
#        --type "SecureString"
#
#   4. テスト実行
#      npm test -- ref/aws-ssm.integration.test.js

# 【例2】環境変数を直接指定してテスト実行
#   environmentType=1 AWS_REGION=ap-northeast-1 npm test -- ref/aws-ssm.integration.test.js

# 【例3】Docker環境でのテスト実行
#   docker run -e environmentType=1 -e AWS_REGION=ap-northeast-1 \
#     -v ~/.aws:/root/.aws:ro \
#     your-image npm test

# ==========================================
# トラブルシューティング
# ==========================================

# 【問題1】SSM Parameter Not Found
#   → aws ssm get-parameter --name heresme.db_auth_info で確認
#
# 【問題2】Access Denied
#   → IAMロール/ユーザーにssm:GetParameter権限を付与
#
# 【問題3】DB接続エラー
#   → RDSセキュリティグループでポート5432を許可
#   → VPC/サブネット設定を確認
#
# 【問題4】AWS認証エラー
#   → aws sts get-caller-identity で認証情報を確認
#   → aws configure list で設定を確認

# ==========================================
# 参考情報
# ==========================================

# IAMポリシー例（SSM Parameter Storeアクセス用）:
# {
#   "Version": "2012-10-17",
#   "Statement": [
#     {
#       "Effect": "Allow",
#       "Action": [
#         "ssm:GetParameter",
#         "ssm:GetParameters"
#       ],
#       "Resource": [
#         "arn:aws:ssm:ap-northeast-1:*:parameter/heresme.*"
#       ]
#     }
#   ]
# }

# RDSセキュリティグループ例:
# インバウンドルール:
#   タイプ: PostgreSQL
#   ポート: 5432
#   ソース: セキュリティグループID（アプリケーション層）

