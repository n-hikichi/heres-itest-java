# 開発環境（localhost）用テスト設定
# このファイルは開発環境でのテスト実施時に使用します
#
# 使用方法:
#   1. このファイルを .env にコピー（またはリネーム）
#   2. 必要に応じて値を調整
#   3. テストを実行
#
# ⚠️ 注意:
#   - このファイルには機密情報を含めないでください
#   - ローカル環境でのテスト用設定です

# ==========================================
# 環境設定
# ==========================================

# Node.js実行環境
NODE_ENV=test

# 環境タイプ（0: localhost、1: AWS検証環境/本番環境）
environmentType=0

# ==========================================
# データベース設定（localhost）
# ==========================================

# PostgreSQL接続情報
DB_HOST=localhost
DB_PORT=5432
DB_NAME=imhere
DB_USER=imhereadmin
DB_PASSWORD=admin555

# DATABASE_URL（オプション）
# DATABASE_URL=postgresql://imhereadmin:admin555@localhost:5432/imhere

# ==========================================
# テスト設定
# ==========================================

# テストタイムアウト（ミリ秒）
JEST_TIMEOUT=30000

# ログレベル（debug, info, warn, error）
LOG_LEVEL=debug

# ==========================================
# Java設定（パスワード暗号化/復号化用）
# ==========================================

# Javaクラスパス（EncDec.classの場所）
JAVA_CLASSPATH=./util

# Javaコマンド（カスタムJDKを使用する場合はパスを指定）
JAVA_CMD=java

# ==========================================
# テストデータ設定
# ==========================================

# テストデータクリーンアップ有効化
TEST_DATA_CLEANUP=true

# テストデータ自動投入有効化
TEST_DATA_AUTO_SETUP=false

# ==========================================
# その他の設定
# ==========================================

# タイムゾーン
TZ=Asia/Tokyo

# ==========================================
# 使用例
# ==========================================

# 【例1】開発環境でのテスト実行
#   1. このファイルを .env にコピー
#      cp ref/.env.test .env
#
#   2. PostgreSQLを起動
#      # Dockerの場合
#      docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=admin555 postgres
#
#   3. テストデータ投入
#      psql -h localhost -U imhereadmin -d imhere < ref/test-data-setup.sql
#
#   4. テスト実行
#      npm test -- ref/db-util.integration.test.js

# 【例2】環境変数を直接指定してテスト実行
#   NODE_ENV=test npm test -- ref/db-util.integration.test.js

# 【例3】全テスト実行
#   ./ref/run-all-integration-tests.sh

# ==========================================
# PostgreSQL初期設定手順
# ==========================================

# 【手順1】PostgreSQLをインストール
#   # Ubuntu/Debian
#   sudo apt-get install postgresql postgresql-contrib
#
#   # macOS
#   brew install postgresql
#
#   # Docker
#   docker run -d --name postgres-test \
#     -p 5432:5432 \
#     -e POSTGRES_USER=imhereadmin \
#     -e POSTGRES_PASSWORD=admin555 \
#     -e POSTGRES_DB=imhere \
#     postgres:14

# 【手順2】データベース作成
#   createdb -U imhereadmin imhere

# 【手順3】スキーマ適用
#   psql -U imhereadmin -d imhere < schema.sql

# 【手順4】テストデータ投入
#   psql -U imhereadmin -d imhere < ref/test-data-setup.sql

# ==========================================
# トラブルシューティング
# ==========================================

# 【問題1】PostgreSQLに接続できない
#   → PostgreSQLが起動しているか確認: pg_isready -h localhost -p 5432
#   → ユーザー/パスワードを確認: psql -U imhereadmin -d imhere -c "SELECT 1"
#
# 【問題2】Javaコマンドが見つからない
#   → Javaがインストールされているか確認: java -version
#   → EncDec.classが配置されているか確認: ls -l util/EncDec.class
#
# 【問題3】テストがタイムアウトする
#   → JEST_TIMEOUT を増やす: JEST_TIMEOUT=60000
#
# 【問題4】Permission denied
#   → スクリプトに実行権限を付与: chmod +x ref/run-all-integration-tests.sh

